HEADER_RE = re.compile(
    r"^\[(?P<room>\d+):(?P<resource>[A-Z0-9]+)#(?P<resource_id>\d+)\]"
    r"\((?P<opcode>[0-9A-F_]+)(?::(?P<actor>EGO|VAR|A\d+))?\)(?P<body>.*)$"
)
ESCAPE_RE = re.compile(r"\\x([0-9A-Fa-f]{2})")
VOICE_RE = re.compile(r"(?:\\xFF\\x0A(?:\\x[0-9A-Fa-f]{2}){2}){4}", re.I)
VOC_MAGIC = b"Creative Voice File\x1a"
